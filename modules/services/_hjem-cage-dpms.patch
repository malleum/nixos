+/* DPMS. Unlike disabling the output through output management, this leaves
+ * it in the layout: the views keep their size, input keeps mapping onto it,
+ * and powering back on is a commit, not a reconfiguration. */
+void
+handle_output_power_manager_set_mode(struct wl_listener *listener, void *data)
+{
+	struct wlr_output_power_v1_set_mode_event *event = data;
+	struct wlr_output *wlr_output = event->output;
+	bool on = event->mode == ZWLR_OUTPUT_POWER_V1_MODE_ON;
+
+	if (wlr_output->enabled == on) {
+		return;
+	}
+
+	struct wlr_output_state state;
+	wlr_output_state_init(&state);
+	wlr_output_state_set_enabled(&state, on);
+	if (!wlr_output_commit_state(wlr_output, &state)) {
+		wlr_log(WLR_ERROR, "Failed to power %s output %s", on ? "on" : "off", wlr_output->name);
+	}
+	wlr_output_state_finish(&state);
+
+	if (on) {
+		wlr_output_schedule_frame(wlr_output);
+	}
+}
+
